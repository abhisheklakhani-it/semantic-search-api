# Copy to .env and adjust. Every setting has a default; see src/semsearch/config.py.
SEMSEARCH_QDRANT_URL=http://localhost:6333
SEMSEARCH_COLLECTION=documents
SEMSEARCH_LOG_LEVEL=INFO
# ONNX Runtime threads per model; the number of physical performance cores is a good start.
SEMSEARCH_MODEL_THREADS=4
